---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base title={`${data.title}, a project by Matthew Towles`} description={data.tagline}>
  <section style="margin-top: 4rem;">
    <p class="eyebrow">Project</p>
    <div class="work-head">
      <h1>{data.title}</h1>
      <span class="status">{data.status}</span>
    </div>
    <p class="lede">{data.tagline}</p>
    <p class="stack" style="margin-top: 1.25rem;">{data.stack.join('  ·  ')}</p>
  </section>

  <div class="spine">
    {data.links.length > 0 && (
      <section class="node" data-live>
        <p class="eyebrow">Try it</p>
        <ul class="linkrow">
          {data.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
        </ul>
      </section>
    )}

    {data.install.length > 0 && (
      <section class="node">
        <p class="eyebrow">Install</p>
        {data.install.map((i) => (
          <div style="margin-bottom: 1.5rem;">
            <p class="stack" style="margin-bottom: 0.4rem;">{i.platform}</p>
            <pre><code>{i.command}</code></pre>
            {i.note && <p class="meta">{i.note}</p>}
          </div>
        ))}
      </section>
    )}

    <section class="node prose">
      <Content />
    </section>

    {data.repos.length > 0 && (
      <section class="node">
        <p class="eyebrow">Source code</p>
        <ul class="work">
          {data.repos.map((r) => (
            <li>
              <div class="work-head">
                <h3><a href={r.url}>{r.name}</a></h3>
                {r.language && <span class="meta">{r.language}</span>}
              </div>
              <p>{r.role}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="node">
      <p class="eyebrow">Role</p>
      <p>{data.role}</p>
    </section>
  </div>
</Base>
