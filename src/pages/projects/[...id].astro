---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.tagline}>
  <p><a href="/">Back to home</a></p>
  <h1>{project.data.title}</h1>
  <p>{project.data.tagline}</p>

  {project.data.links.length > 0 && (
    <>
      <h2>Try it</h2>
      <ul>
        {project.data.links.map((l) => (
          <li><a href={l.url}>{l.label}</a></li>
        ))}
      </ul>
    </>
  )}

  {project.data.install.length > 0 && (
    <>
      <h2>Install</h2>
      {project.data.install.map((i) => (
        <div>
          <h3>{i.platform}</h3>
          <pre><code>{i.command}</code></pre>
          {i.note && <p>{i.note}</p>}
        </div>
      ))}
    </>
  )}

  <Content />

  <h2>Details</h2>
  <dl>
    <dt>Role</dt><dd>{project.data.role}</dd>
    <dt>Status</dt><dd>{project.data.status}</dd>
    <dt>Built with</dt><dd>{project.data.stack.join(', ')}</dd>
  </dl>

  {project.data.repos.length > 0 && (
    <>
      <h2>Source code</h2>
      <ul>
        {project.data.repos.map((r) => (
          <li>
            <a href={r.url}>{r.name}</a>
            {r.language && <span> ({r.language})</span>}
            <p>{r.role}</p>
          </li>
        ))}
      </ul>
    </>
  )}
</Base>
