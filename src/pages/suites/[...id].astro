---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const suites = await getCollection('suites');
  return suites.map((suite) => ({ params: { id: suite.id }, props: { suite } }));
}

const { suite } = Astro.props;
const { Content } = await render(suite);
const components = await Promise.all(suite.data.components.map((ref) => getEntry(ref)));
---

<Base title={suite.data.title} description={suite.data.tagline}>
  <p><a href="/">← Home</a></p>
  <h1>{suite.data.title}</h1>
  <p>{suite.data.tagline}</p>
  <Content />
  <h2>Components</h2>
  <ul>
    {components.map((c) => (
      <li><a href={`/projects/${c!.id}/`}>{c!.data.title}</a> — {c!.data.tagline}</li>
    ))}
  </ul>
</Base>
