---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Matthew Towles" description="Engineering portfolio.">
  <h1>Matthew Towles</h1>

  <h2>Projects</h2>
  <ul>
    {projects.map((p) => (
      <li>
        <a href={`/projects/${p.id}/`}>{p.data.title}</a>
        <p>{p.data.tagline}</p>
        <p>{p.data.repos.length} {p.data.repos.length === 1 ? 'repository' : 'repositories'}</p>
      </li>
    ))}
  </ul>
</Base>
