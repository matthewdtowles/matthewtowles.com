---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, socials } from '../config/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={`${site.name}, software engineer`}>
  <section style="margin-top: 5rem;">
    <h1>{site.name}</h1>
    <p class="lede">{site.lede}</p>
  </section>

  <div class="spine">
    <section class="node" id="work" data-live>
      <p class="eyebrow">Selected work</p>
      <ul class="work">
        {projects.map((p) => (
          <li>
            <div class="work-head">
              <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
              <span class="status">{p.data.status}</span>
            </div>
            <p>{p.data.tagline}</p>
            <p class="stack">{p.data.stack.join('  ·  ')}</p>
            {p.data.links.length > 0 && (
              <ul class="linkrow" style="margin-top: 0.75rem;">
                {p.data.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="node">
      <p class="eyebrow">Background</p>
      <p>
        Ten years building distributed systems, most recently leading event driven
        integration and testing architecture at Travelers. Master's in computer
        science from Georgia Tech.
      </p>
      <ul class="linkrow">
        <li><a href="/resume/">Read the full resume</a></li>
      </ul>
    </section>

    <section class="node">
      <p class="eyebrow">Elsewhere</p>
      <ul class="linkrow">
        <li><a href={`mailto:${site.email}`}>Email</a></li>
        {socials.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
      </ul>
    </section>
  </div>
</Base>
