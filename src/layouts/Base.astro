---
import '../styles/global.css';
import { site, socials } from '../config/site';
import { ogSlug } from '../config/og-slug.mjs';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.lede } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${ogSlug(Astro.url.pathname)}.png`, Astro.site);
const isHome = Astro.url.pathname === '/';

// Ties the domain to the person, so a search for the name can surface the
// profiles alongside it.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  sameAs: socials.map((s) => s.url),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline src="/theme.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@600&family=IBM+Plex+Sans:wght@400;600&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <header class="masthead">
        {isHome ? (
          <span class="wordmark">{site.name}</span>
        ) : (
          <a class="wordmark" href="/">{site.name}</a>
        )}
        <nav class="nav" aria-label="Main">
          <a href="/#work">Work</a>
          <a href="/resume/">Resume</a>
          <a href={`mailto:${site.email}`}>Contact</a>
          <button type="button" data-theme-toggle data-state="system" hidden>
            <svg class="icon icon-system" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M8 2a6 6 0 0 0 0 12z" fill="currentColor" />
            </svg>
            <svg class="icon icon-light" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5" />
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M8 1v1.75M8 13.25V15M15 8h-1.75M2.75 8H1" />
                <path d="M12.95 3.05l-1.24 1.24M4.29 11.71l-1.24 1.24M12.95 12.95l-1.24-1.24M4.29 4.29L3.05 3.05" />
              </g>
            </svg>
            <svg class="icon icon-dark" viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M13.5 10.2A5.8 5.8 0 0 1 5.8 2.5a5.8 5.8 0 1 0 7.7 7.7z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="colophon">
        <span>{site.name}</span>
        <span>
          Built with Astro, served from CloudFront.
          <a href="https://github.com/matthewdtowles/matthewtowles.com">Source</a>
        </span>
      </footer>
    </div>
  </body>
</html>
